{
  "name": "zhixuanche-business-portal",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "部门业务门户，独立应用发布与 Docker 部署",
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "dev": "node scripts/start-local.mjs",
    "dev:static": "node scripts/dev-server.mjs",
    "dev:sop": "node scripts/dev-sop.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:py": "python -B -m unittest discover -s tests",
    "test:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/tests/Run-Tests.ps1",
    "prepare:apps": "node scripts/prepare-apps.mjs",
    "stop": "node scripts/stop-local.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "register:app": "node scripts/register-app.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
