<?xml version="1.0" encoding="utf-8"?>
<!-- EXAMPLE ONLY: merge <rewrite> into the portal web.config's system.webServer.
     Requires URL Rewrite + ARR, and server-level ARR proxy already enabled.
     Backend receives /path, not /leads/path. It must generate public /leads/ URLs.
     This fragment does not enable Windows authentication or forward trusted identities. -->
<rewrite>
  <rules>
    <rule name="Leads trailing slash" stopProcessing="true">
      <match url="^leads$" />
      <action type="Redirect" url="/leads/" redirectType="Temporary" appendQueryString="true" />
    </rule>
    <rule name="Leads local service" stopProcessing="true">
      <match url="^leads/(.*)$" />
      <action type="Rewrite" url="http://127.0.0.1:8501/{R:1}" appendQueryString="true" />
    </rule>
  </rules>
</rewrite>
