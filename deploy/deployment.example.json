{
  "deploymentRoot": "../../PlanHub部署",
  "siteName": "DataPlatform",
  "applications": {
    "planhub": {
      "kind": "portal",
      "healthUrl": "http://localhost:8080/"
    },
    "leads": {
      "kind": "static",
      "healthUrl": "http://localhost:8080/leads/"
    },
    "forecast": {
      "kind": "service",
      "healthUrl": "http://localhost:8080/forecast/healthz",
      "command": "runtime/forecast/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/dynamic/serve.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--no-open",
        "--data-dir",
        "{data}",
        "--public-prefix",
        "/forecast/"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "SHARED_DATA_ROOT": "{deployment}/shared"
      },
      "dataDirectory": "data/forecast",
      "port": 8780,
      "taskName": "PlanHub-forecast",
      "serviceAccount": "MACHINE\\PlanHubService",
      "backendHealthPath": "/healthz",
      "healthExpected": {
        "ok": true,
        "app": "sales-forecast-live",
        "public_prefix": "/forecast/"
      },
      "proxyMode": "prefix",
      "stripPrefix": true,
      "maxRequestBytes": 269484032
    },
    "orderiq": {
      "kind": "service",
      "healthUrl": "http://localhost:8080/orderiq/",
      "command": "runtime/orderiq/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--input",
        "{deployment}/shared/订单汇总",
        "--data-dir",
        "{data}/runtime",
        "--state-dir",
        "{data}/annotations",
        "--web-dir",
        "{payload}/web",
        "--allowed-host",
        "localhost",
        "--allowed-origin",
        "http://localhost:8080"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "dataDirectory": "data/orderiq",
      "port": 8766,
      "taskName": "PlanHub-orderiq",
      "serviceAccount": "MACHINE\\PlanHubService",
      "backendHealthPath": "/health",
      "healthExpected": {
        "application": "order-dashboard"
      },
      "proxyMode": "prefix",
      "stripPrefix": true,
      "maxRequestBytes": 269484032
    },
    "quicklook": {
      "kind": "service",
      "healthUrl": "http://localhost:8080/quicklook/",
      "command": "runtime/quicklook/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--port",
        "{port}"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "DATA_QUICKLOOK_DATA_DIR": "{data}",
        "DATA_QUICKLOOK_SOURCE_BASE": "{deployment}/shared",
        "DATA_QUICKLOOK_PUBLIC_PREFIX": "/quicklook/",
        "DATA_QUICKLOOK_PUBLIC_ORIGIN": "http://localhost:8080",
        "SHARED_DATA_ROOT": "{deployment}/shared"
      },
      "dataDirectory": "data/quicklook",
      "port": 8765,
      "taskName": "PlanHub-quicklook",
      "serviceAccount": "MACHINE\\PlanHubService",
      "backendHealthPath": "/healthz",
      "healthExpected": {
        "ok": true,
        "app": "quicklook"
      },
      "proxyMode": "prefix",
      "stripPrefix": true,
      "maxRequestBytes": 269484032
    },
    "sop": {
      "kind": "service",
      "healthUrl": "http://localhost:8080/sop/api/health",
      "command": "runtime/sop/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--gateway-config",
        "{deployment}/config/sop.json"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "SOP_EXCEL_ENGINE": "python",
        "SHARED_DATA_ROOT": "{deployment}/shared",
        "SOP_RECONCILE_DIR": "{deployment}/shared/对账资料"
      },
      "secretEnvironmentFiles": {
        "SOP_PROXY_SECRET": "config/sop-proxy.secret"
      },
      "dataDirectory": "data/sop",
      "port": 8877,
      "taskName": "PlanHub-sop",
      "serviceAccount": "MACHINE\\PlanHubService",
      "backendHealthPath": "/sop/api/health",
      "healthExpected": {
        "app_id": "hima-sop",
        "launch_mode": "gateway"
      },
      "proxyMode": "existing",
      "backendHealthMode": "public"
    }
  }
}
