{
  "deploymentRoot": "../../PlanHub部署",
  "siteName": "DataPlatform",
  "publicOrigin": "http://localhost:8080",
  "sharedDirectory": "shared",
  "serviceAccount": "MACHINE\\PlanHubService",
  "applications": {
    "planhub": {
      "kind": "portal"
    },
    "leads": {
      "kind": "static"
    },
    "forecast": {
      "kind": "service",
      "command": "runtime/forecast/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/dynamic/serve.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--no-open",
        "--data-dir",
        "{data}",
        "--public-prefix",
        "{basePath}"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "SHARED_DATA_ROOT": "{shared}"
      },
      "dataDirectory": "data/forecast",
      "port": 8780,
      "taskName": "PlanHub-forecast",
      "backendHealthPath": "/healthz",
      "healthExpected": {
        "ok": true,
        "app": "sales-forecast-live",
        "public_prefix": "{basePath}"
      },
      "proxyMode": "prefix",
      "stripPrefix": true,
      "maxRequestBytes": 269484032
    },
    "orderiq": {
      "kind": "service",
      "command": "runtime/orderiq/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--input",
        "{shared}/订单汇总",
        "--data-dir",
        "{data}/runtime",
        "--state-dir",
        "{data}/annotations",
        "--web-dir",
        "{payload}/web",
        "--allowed-host",
        "{publicHost}",
        "--allowed-origin",
        "{publicOrigin}"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "dataDirectory": "data/orderiq",
      "port": 8767,
      "taskName": "PlanHub-orderiq",
      "backendHealthPath": "/health",
      "healthExpected": {
        "application": "order-dashboard"
      },
      "proxyMode": "prefix",
      "stripPrefix": true,
      "maxRequestBytes": 269484032
    },
    "quicklook": {
      "kind": "service",
      "command": "runtime/quicklook/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--port",
        "{port}"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "DATA_QUICKLOOK_DATA_DIR": "{data}",
        "DATA_QUICKLOOK_SOURCE_BASE": "{shared}",
        "DATA_QUICKLOOK_PUBLIC_PREFIX": "{basePath}",
        "DATA_QUICKLOOK_PUBLIC_ORIGIN": "{publicOrigin}",
        "SHARED_DATA_ROOT": "{shared}"
      },
      "dataDirectory": "data/quicklook",
      "port": 8765,
      "taskName": "PlanHub-quicklook",
      "backendHealthPath": "/healthz",
      "healthExpected": {
        "ok": true,
        "app": "quicklook"
      },
      "proxyMode": "prefix",
      "stripPrefix": true,
      "maxRequestBytes": 269484032
    },
    "sop": {
      "kind": "service",
      "command": "runtime/sop/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--gateway-config",
        "{deployment}/config/sop.json"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "SOP_EXCEL_ENGINE": "python",
        "SHARED_DATA_ROOT": "{shared}",
        "SOP_RECONCILE_DIR": "{shared}/对账资料"
      },
      "secretEnvironmentFiles": {
        "SOP_PROXY_SECRET": "config/sop-proxy.secret"
      },
      "dataDirectory": "data/sop",
      "port": 8877,
      "taskName": "PlanHub-sop",
      "backendHealthPath": "/sop/api/health",
      "healthExpected": {
        "app_id": "hima-sop",
        "launch_mode": "gateway"
      },
      "proxyMode": "existing",
      "backendHealthMode": "public",
      "gatewayPaths": {
        "source_dir": "{shared}/订单汇总",
        "shared_config": "{deployment}/config/shared_config.py",
        "plan_file": "{shared}/SOP计划/SOP计划维护.xlsx"
      }
    },
    "vehicle-config": {
      "kind": "service",
      "command": "runtime/vehicle-config/Scripts/python.exe",
      "arguments": [
        "-B",
        "{payload}/server.py",
        "--host",
        "127.0.0.1",
        "--port",
        "{port}",
        "--data-dir",
        "{data}",
        "--public-prefix",
        "{basePath}",
        "--public-origin",
        "{publicOrigin}",
        "--require-proxy-identity"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "secretEnvironmentFiles": {
        "VEHICLE_CONFIG_PROXY_SECRET": "config/vehicle-config-proxy.secret"
      },
      "dataDirectory": "{shared}/车型配置",
      "port": 8790,
      "taskName": "PlanHub-vehicle-config",
      "backendHealthPath": "/healthz",
      "healthExpected": {
        "ok": true,
        "app": "vehicle-config",
        "public_prefix": "{basePath}"
      },
      "proxyMode": "existing",
      "stripPrefix": true,
      "maxRequestBytes": 8000000
    }
  }
}
