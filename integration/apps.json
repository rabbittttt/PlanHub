{
  "applications": {
    "orderiq": {
      "type": "proxy",
      "target": "http://127.0.0.1:8767",
      "stripPrefix": true,
      "rootRoutes": [],
      "healthPath": "/health",
      "healthKeys": [
        "status",
        "application"
      ],
      "start": {
        "cwd": "../订单分析/scripts/generate_html",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py",
          "--port",
          "{port}"
        ]
      }
    },
    "forecast": {
      "type": "proxy",
      "target": "http://127.0.0.1:8780",
      "stripPrefix": true,
      "rootRoutes": [],
      "healthPath": "/healthz",
      "healthKeys": [
        "ok",
        "app"
      ],
      "start": {
        "cwd": "../销量预测",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "dynamic/serve.py",
          "--host",
          "{host}",
          "--port",
          "{port}",
          "--no-open",
          "--public-prefix",
          "{basePath}"
        ]
      },
      "healthExpected": {
        "ok": true,
        "app": "sales-forecast-live",
        "public_prefix": "{basePath}"
      }
    },
    "quicklook": {
      "type": "proxy",
      "target": "http://127.0.0.1:8765",
      "stripPrefix": true,
      "rootRoutes": [],
      "healthPath": "/healthz",
      "healthKeys": [
        "ok",
        "app"
      ],
      "start": {
        "cwd": "../数据速查",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py",
          "--port",
          "{port}"
        ],
        "env": {
          "DATA_QUICKLOOK_PUBLIC_PREFIX": "{basePath}"
        }
      },
      "healthTimeoutMs": 5000,
      "diagnosticChecks": [
        {
          "name": "目录与数据接口",
          "path": "/api/catalog",
          "keys": [
            "tables",
            "files",
            "status",
            "config"
          ]
        }
      ]
    },
    "leads": {
      "type": "static",
      "root": "../线索声量",
      "entry": "lead-dashboard.html",
      "publicPaths": [
        "lead-dashboard.html"
      ]
    }
  }
}
