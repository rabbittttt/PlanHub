{
  "applications": {
    "orderiq": {
      "type": "proxy",
      "target": "http://127.0.0.1:8766",
      "stripPrefix": true,
      "rootRoutes": [],
      "healthPath": "/api/health",
      "healthKeys": [
        "status",
        "application",
        "dataset_id"
      ],
      "start": {
        "cwd": "../订单分析/scripts/generate_html",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py"
        ]
      }
    },
    "forecast": {
      "type": "static",
      "root": "../销量预测/output_file",
      "entry": "鸿蒙智行销量预测.html",
      "publicPaths": [
        "鸿蒙智行销量预测.html",
        "forecast_assets/"
      ]
    },
    "quicklook": {
      "type": "proxy",
      "target": "http://127.0.0.1:8765",
      "stripPrefix": true,
      "rootRoutes": [],
      "healthPath": "/healthz",
      "healthKeys": [
        "ok",
        "app"
      ],
      "start": {
        "cwd": "../数据速查",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py"
        ],
        "env": {
          "DATA_QUICKLOOK_PUBLIC_PREFIX": "/quicklook/"
        }
      },
      "healthTimeoutMs": 5000,
      "diagnosticChecks": [
        {
          "name": "目录与数据接口",
          "path": "/api/catalog",
          "keys": [
            "tables",
            "files",
            "status",
            "config"
          ]
        }
      ]
    },
    "leads": {
      "type": "static",
      "root": "../线索声量",
      "entry": "lead-dashboard.html",
      "publicPaths": [
        "lead-dashboard.html"
      ]
    }
  }
}
