{
  "sharedDataRoot": "../工作台数据/shared",
  "applications": {
    "orderiq": {
      "type": "proxy",
      "target": "http://127.0.0.1:{port}",
      "rootRoutes": [],
      "start": {
        "cwd": "../订单分析/scripts/generate_html",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py",
          "--port",
          "{port}"
        ]
      },
      "useReleaseContract": true
    },
    "forecast": {
      "type": "proxy",
      "target": "http://127.0.0.1:{port}",
      "rootRoutes": [],
      "start": {
        "cwd": "../销量预测",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "dynamic/serve.py",
          "--host",
          "{host}",
          "--port",
          "{port}",
          "--no-open",
          "--public-prefix",
          "{basePath}"
        ]
      },
      "useReleaseContract": true
    },
    "quicklook": {
      "type": "proxy",
      "target": "http://127.0.0.1:{port}",
      "rootRoutes": [],
      "start": {
        "cwd": "../数据速查",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py",
          "--port",
          "{port}"
        ],
        "env": {
          "DATA_QUICKLOOK_PUBLIC_PREFIX": "{basePath}"
        }
      },
      "healthTimeoutMs": 5000,
      "diagnosticChecks": [
        {
          "name": "目录与数据接口",
          "path": "/api/catalog",
          "keys": [
            "tables",
            "files",
            "status",
            "config"
          ]
        }
      ],
      "useReleaseContract": true
    },
    "leads": {
      "type": "static",
      "root": "../线索声量",
      "entry": "lead-dashboard.html",
      "publicPaths": [
        "lead-dashboard.html"
      ]
    },
    "vehicle-config": {
      "type": "proxy",
      "target": "http://127.0.0.1:{port}",
      "rootRoutes": [],
      "start": {
        "cwd": "../配置管理",
        "command": "../.venv/Scripts/python.exe",
        "args": [
          "-B",
          "server.py",
          "--host",
          "{host}",
          "--port",
          "{port}",
          "--public-prefix",
          "{basePath}"
        ]
      },
      "useReleaseContract": true
    }
  },
  "dataRoot": "../工作台数据"
}
